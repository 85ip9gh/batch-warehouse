# The raw corpus is never committed. Reasons in README.md under "What is not
# in this repository", and all three are independent of each other:
# employer-authored posting text, third-party contact details, and size.
/data/
# Anchored with a leading slash. Unanchored, `warehouse/` also matches
# src/warehouse/, which silently excluded the entire source package.
/warehouse/
*.csv
*.parquet
!tests/fixtures/*.csv

# Local environment
.venv/
__pycache__/
*.pyc
.pytest_cache/
.env

# Spark
spark-warehouse/
metastore_db/
derby.log
